@page "/Venta/Index"

@rendermode InteractiveServer

@inject VentasServices ventasServices

<PageTitle>Index</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 50px;">
            <h5 class="mb-0">Consulta de Ventas</h5>

            <a href="/Venta/Create" class="btn btn-primary">
                Crear
            </a>
        </div>

        <div class="card-body">
            <div class="d-flex align-items-center gap-4">

                <div>
                    <label class="form-label"><strong>Filtrar por</strong></label>

                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="0" disabled selected>Elige una opción</option>
                        <option value="Id">Id</option>
                        <option value="Fecha">Fecha</option>
                        <option value="Concepto">Concepto</option>
                    </InputSelect>
                </div>

                <div>
                    <label class="form-label"><strong>Búsqueda</strong></label>

                    <div class="input-group">
                        <input class="form-control" placeholder="Buscar..." @bind="ValorFiltro" />

                        <button class="btn btn-outline-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

                <div class="d-flex align-items-center gap-4 mt-3">
                    <div>
                        <label class="form-label"><strong>Desde</strong></label>

                        <InputDate class="form-control" @bind-Value="Desde" />
                    </div>

                    <div>
                        <label class="form-label"><strong>Hasta</strong></label>

                        <InputDate class="form-control" @bind-Value="Hasta" />
                    </div>

                </div>

            <QuickGrid Items="@Ventas.AsQueryable()" Class="table table-bordered mt-4 align-middle">
                <PropertyColumn Property="@(v => v.VentaId)" Title="Id" Sortable="true" />
                <PropertyColumn Property="@(v => v.Fecha)" Title="Fecha" Sortable="true" />
                <PropertyColumn Property="@(v => v.Observacion)" Title="Observación" Sortable="true" />
                <PropertyColumn Property="@(v => v.Total)" Title="Total" />

                <TemplateColumn Title="Opciones">
                    <div class="d-flex gap-2">
                        <a href="/Venta/Edit/@context.VentaId" class="btn btn-warning">Editar</a>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <p class="mb-0"><strong>Cantidad: </strong>@Ventas.Count</p>
            <p class="mb-0"><strong>Total: </strong>@Ventas.Sum(v => v.Total)</p>
        </div>
    </div>
</div>

@code
{
    public List<Ventas> Ventas { get; set; } = new();

    public string Filtro = "0";
    public string ValorFiltro = "";

    public DateOnly? Desde { get; set; }
    public DateOnly? Hasta { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ventasResult = await ventasServices.GetList(v => true);

        if (ventasResult.IsSuccess)
        {
            Ventas = ventasResult.Value;
        }
    }

    private async Task Buscar()
    {

        if (Filtro == "Fecha")
        {
            var ventasResult = await ventasServices.GetList(f => f.Fecha >= Desde && f.Fecha <= Hasta);

            if (ventasResult.IsSuccess)
            {
                Ventas = ventasResult.Value!;
            }
        }

        else if (ValorFiltro.Trim() != "" && Filtro == "Id" && int.TryParse(ValorFiltro, out int ventaId))
        {
            var ventasResult = await ventasServices.GetList(v => v.VentaId == ventaId);

            if (ventasResult.IsSuccess)
            {
                Ventas = ventasResult.Value!;
            }
        }

        else if (ValorFiltro.Trim() != "" && Filtro == "Concepto")
        {
            var ventasResult = await ventasServices.GetList(v => v.Observacion.ToLower().Contains(ValorFiltro.ToLower()));

            if (ventasResult.IsSuccess)
            {
                Ventas = ventasResult.Value!;
            }
        }

        else
        {
            var ventasResult = await ventasServices.GetList(v => true);

            if (ventasResult.IsSuccess)
            {
                Ventas = ventasResult.Value!;
            }
        }
    }
}
